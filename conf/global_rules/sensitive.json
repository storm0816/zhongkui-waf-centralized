{
    "moduleName": "敏感数据过滤",
    "nextId": 5,
    "rules": [
        {
            "id": 1,
            "state": "off",
            "description": "身份证号码",
            "action": "detect",
            "rule": "[1-9]\\d{5}(?:18|19|20)\\d{2}(?:0[1-9]|10|11|12)(?:0[1-9]|[1-2]\\d|30|31)\\d{3}[\\dXx]"
        },
        {
            "id": 2,
            "state": "off",
            "description": "手机号码",
            "action": "detect",
            "rule": "(?:(?:\\+|00)86)?1(?:(?:3[\\d])|(?:4[5-79])|(?:5[0-35-9])|(?:6[5-7])|(?:7[0-8])|(?:8[\\d])|(?:9[189]))\\d{8}(?:$|\\D)"
        },
        {
            "id": 3,
            "state": "off",
            "description": "银行卡号",
            "action": "detect",
            "rule": "[1-9](?:\\d{15}|\\d{16}|\\d{18})(?:$|\\D)"
        },
        {
            "id": 4,
            "state": "off",
            "description": "密码",
            "action": "detect",
            "rule": "(?:password|passwd)\"\\s*[:=]\\s*\"(\\S+?)(?<!\\\\)\""
        }
    ]
}
