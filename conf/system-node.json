{
    "attackLog": {
        "state": "on",
        "logPath": "/opt/openresty/nginx/logs/hack/",
        "jsonFormat": "off",
        "response_body_max_bytes": 1024
    },
    "attackLogRetention": {
        "state": "on",
        "days": 90,
        "batch_size": 5000,
        "interval_seconds": 300
    },
    "geoip": {
        "file": "/opt/openresty/share/GeoIP/GeoLite2-City.mmdb",
        "language": "zh-CN"
    },
    "html": "",
    "secret": "CHANGE_ME",
    "auth": {
        "mfa_required": "off"
    },
    "mysql": {
        "state": "off"
    },
    "redis": {
        "state": "on",
        "host": "10.10.10.10",
        "password": "",
        "timeouts": "1000,1000,1000",
        "poolSize": 10,
        "failure_threshold": 3,
        "failure_window_seconds": 30,
        "degrade_seconds": 10,
        "queue_max_len": 200000,
        "ssl": "off",
        "port": 16379,
        "db": 0,
        "expire_time": 120
    },
    "rulesSort": {
        "state": "off",
        "period": 10
    },
    "master": {
        "state": "off"
    },
    "centralized": {
        "state": "on"
    },
    "ipBlacklist": {
        "expire_time": 1800
    },
    "system": {
        "expire": 120,
        "node_offline_grace": 180,
        "node_retention": 86400,
        "attack_log_flush_interval_seconds": 10,
        "attack_log_flush_batch_size": 2000,
        "attack_log_flush_max_batches_per_round": 10
    },
    "dingtalk": {
        "state": "off",
        "webhook": "",
        "at_mobiles": ""
    }
}
